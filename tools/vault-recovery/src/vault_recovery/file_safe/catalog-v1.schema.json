{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://passkeylocal.invalid/file-safe/catalog-v1.schema.json",
  "title": "File Safe catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "vault_id",
    "key_epoch_id",
    "snapshot_id",
    "commit_sequence",
    "prior_snapshot_id",
    "folders",
    "files",
    "policy"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "vault_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "key_epoch_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "commit_sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "prior_snapshot_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "folders": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "parent_id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "type": "string",
            "maxLength": 255
          }
        }
      }
    },
    "files": {
      "type": "array",
      "maxItems": 50000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "folder_id",
          "name",
          "tags",
          "notes",
          "favorite",
          "created_at",
          "modified_at",
          "deleted",
          "current_version_id",
          "versions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "folder_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "tags": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "notes": {
            "type": "string",
            "maxLength": 4096
          },
          "favorite": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
          },
          "modified_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
          },
          "deleted": {
            "type": "boolean"
          },
          "current_version_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "versions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 11,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "object_id",
                "object_key",
                "plaintext_size",
                "sha256",
                "created_at",
                "media_hint"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                },
                "object_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                },
                "object_key": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9+/]{43}=$"
                },
                "plaintext_size": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1099511627776
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "created_at": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
                },
                "media_hint": {
                  "type": "string",
                  "maxLength": 128
                }
              }
            }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "history_previous_versions"
      ],
      "properties": {
        "history_previous_versions": {
          "const": 10
        }
      }
    }
  }
}
