{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the local main Windows webview can invoke the fixed vault operations.",
  "windows": [
    "main"
  ],
  "platforms": [
    "windows"
  ],
  "permissions": [
    "allow-session-begin",
    "allow-session-end",
    "allow-storage",
    "allow-pick-import",
    "allow-export-backup",
    "allow-native-status",
    "allow-configure-backup",
    "allow-retry-backup",
    "allow-backup-retention",
    "allow-open-external",
    "allow-native-activity",
    "allow-hello-enroll",
    "allow-hello-status",
    "allow-hello-verify",
    "allow-hello-key-proof",
    "allow-hello-oaep-capability",
    "allow-hello-pkcs1-compatibility",
    "allow-hello-pkcs1-behavior",
    "allow-hello-attestation-capability",
    "allow-hello-webauthn-capability",
    "allow-hello-prf-proof",
    "allow-hello-settings",
    "allow-hello-unlock",
    "allow-hello-revoke",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-destroy",
    "allow-file-safe-status",
    "allow-file-safe-access",
    "allow-file-safe-lock",
    "allow-lock-all",
    "allow-file-safe-activity",
    "allow-file-safe-interval",
    "allow-file-safe-page",
    "allow-file-safe-change",
    "allow-file-safe-import",
    "allow-file-safe-cancel",
    "allow-file-safe-export",
    "allow-file-safe-rotate",
    "allow-file-safe-backup",
    "allow-file-safe-recover",
    "allow-file-safe-retry-backup",
    "allow-file-safe-import-results"
  ]
}
