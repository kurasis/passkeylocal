{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the local main Windows webview can invoke the fixed vault operations.",
  "windows": ["main"],
  "platforms": ["windows"],
  "permissions": [
    "allow-session-begin", "allow-session-end", "allow-storage", "allow-pick-import",
    "allow-export-backup", "allow-native-status", "allow-configure-backup",
    "allow-retry-backup", "allow-backup-retention", "allow-open-external", "allow-native-activity",
    "allow-hello-enroll", "allow-hello-unlock", "allow-hello-revoke",
    "core:event:allow-listen", "core:event:allow-unlisten", "core:window:allow-destroy"
  ]
}
